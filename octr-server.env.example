# OnlineCTR server settings for this host.
#
# Copy this file to octr-server.env and fill it in. octr-server.env is
# git-ignored: never commit it, and keep it readable only by the account the
# server runs as (chmod 600 octr-server.env). Docker reads it through
# compose.yml (env_file), systemd through EnvironmentFile=.
#
# The heartbeat (the server's status on the site and the launcher) runs only
# with both OCTR_HEARTBEAT_URL and OCTR_HEARTBEAT_SECRET set; leave either
# empty and the server runs as normal, unlisted.

# The site's heartbeat endpoint (from the OnlineCTR team).
OCTR_HEARTBEAT_URL=

# This server's own secret, issued for its ID by the OnlineCTR team.
OCTR_HEARTBEAT_SECRET=

# This server's ID on the site, e.g. aus1.
OCTR_HEARTBEAT_ID=

# The key every server shares, so the site's "seen in the past 7 days" counts a
# player once across regions (from the OnlineCTR team).
OCTR_HEARTBEAT_SEEN_KEY=

# Seconds between posts to the site (default 30, minimum 5).
#OCTR_HEARTBEAT_INTERVAL=30
